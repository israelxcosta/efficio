# Build context for apps/api/Dockerfile. Everything not needed by the image stays out: secrets,
# VCS metadata, tests, docs, local tooling and build artifacts.

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/dist-demo
**/build
**/coverage
**/*.tsbuildinfo
**/.vite
**/.turbo

# Secrets and local configuration (never in a layer)
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/id_rsa*
**/.npmrc
**/.aws
**/*.tfstate
**/*.tfstate.*
**/.terraform

# VCS, CI, editors, agent tooling
.git
.github
.claude
.vscode
.idea
**/.DS_Store

# Tests and reports
**/test
**/*.test.ts
**/*.spec.ts
playwright-report
test-results
**/*.log

# Docs and the web app sources (the API image only needs apps/web/package.json for the lockfile)
docs
**/*.md
apps/web/src
apps/web/public
apps/web/index.html
