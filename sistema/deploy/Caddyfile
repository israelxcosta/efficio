# Caddy do Efficio: HTTPS automático (Let's Encrypt), web estático e proxy de /api para a API.
# Embutido na imagem por deploy/web.Dockerfile (mudou aqui? rode scripts/atualizar.sh).
# DOMAIN e ACME_EMAIL vêm do .env (docker-compose.prod.yml).

{
	email {$ACME_EMAIL}
	# Sem API de administração (porta 2019): a configuração só muda recriando o contêiner.
	admin off
	servers {
		# HTTP/1.1 e HTTP/2 (sem HTTP/3/UDP: só as portas TCP 80 e 443 ficam abertas no firewall).
		protocols h1 h2
	}
}

# Cabeçalhos de segurança do site (equivalentes aos do CloudFront em docs/deploy-aws.md).
(seguranca) {
	header {
		# Sem preload: só depois de confirmar que TODO subdomínio de efficio.com.br serve HTTPS.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Cross-Origin-Resource-Policy "same-origin"
	}
	# Content-Security-Policy gerada no build a partir da <meta> do dist/index.html (mesmos hashes de
	# script) + frame-ancestors 'none' e upgrade-insecure-requests (ver web.Dockerfile).
	import /etc/caddy/csp.caddy
}

www.{$DOMAIN} {
	import seguranca
	header -Server
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	header -Server
	# Log de acesso minimizado (LGPD art. 6º, III; OWASP Logging): sem tokens, IP truncado, sem cabeçalhos
	# identificadores. Tokens no caminho (links de 30 dias do onboarding /o/<token>, convites
	# /convite/<token>, as rotas públicas da API e o segredo do webhook do Open Finance) viram ***;
	# toda querystring sai (o link de redefinir senha usa #fragmento, que nem chega ao servidor).
	# Referer sai porque, com Referrer-Policy same-origin, os assets e chamadas /api feitos pela página
	# /o/<token> carregam o token nele. IP: /24 (IPv4) e /48 (IPv6), o bastante para investigar abuso
	# por rede; o IP completo para auditoria fica no audit_logs da API (com retenção própria).
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp "^/(o|convite|api/public/onboarding|api/invites|api/open-finance/webhooks/[^/?]+)/[^/?]+" "/${1}/***"
			request>uri regexp "[?].*$" "?***"
			request>remote_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>client_ip ip_mask {
				ipv4 24
				ipv6 48
			}
			request>headers>User-Agent delete
			request>headers>Referer delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Forwarded-For delete
			resp_headers>Set-Cookie delete
		}
	}

	# API: a resposta já traz os cabeçalhos do helmet. Corpo até 15 MB (anexo de 10 MB em base64 no
	# JSON ≈ 13,4 MB; a própria API aplica limites menores por rota).
	handle /api/* {
		request_body {
			max_size 15MB
		}
		reverse_proxy api:3333 {
			header_down -Server
			header_down -X-Powered-By
		}
	}

	# Arquivos com hash no nome: cache de 1 ano. Arquivo inexistente = 404 (nunca o index.html).
	handle /assets/* {
		import seguranca
		root * /srv
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Demais rotas: SPA (React Router) cai no index.html, sempre revalidado.
	handle {
		import seguranca
		root * /srv
		encode zstd gzip
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Healthcheck do contêiner (só dentro dele; esta porta não é publicada).
http://:8081 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}
