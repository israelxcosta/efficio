# Modelo do deploy/.env do VPS (docs/deploy-hostinger.md). NÃO copie à mão: rode
#   ./scripts/gerar-segredos.sh
# que cria o .env com chmod 600 e segredos aleatórios. Este arquivo só documenta as variáveis e é
# usado pelo CI para validar o docker-compose.prod.yml. Nenhum valor aqui é real.
#
# Guarde FORA do servidor (gerenciador de senhas ou papel em local seguro): ENCRYPTION_MASTER_KEY e a
# senha dos backups. Sem elas nenhum backup pode ser lido.
# Valores com $ ou espaço: use aspas simples ('...'). Não use aspas simples dentro do valor.

# --- Site --------------------------------------------------------------------------------------
DOMAIN=efficio.com.br
# Recebe avisos do Let's Encrypt sobre o certificado.
ACME_EMAIL=contato@efficio.com.br

# --- Banco (definidas só na primeira subida; trocar aqui depois NÃO muda a senha no banco) --------
# Superusuário de manutenção (backup/restauração). Gerada pelo script.
POSTGRES_PASSWORD=gerado-pelo-script
# Usuário "efficio" da API. Gerada pelo script (só letras e números: vai dentro da DATABASE_URL).
EFFICIO_DB_PASSWORD=gerado-pelo-script

# --- API -----------------------------------------------------------------------------------------
# 43+ caracteres aleatórios. Trocar = todos precisam entrar de novo.
JWT_SECRET=gerado-pelo-script
# Base64 de 32 bytes aleatórios. Cifra os dados pessoais no banco. NUNCA troque nem perca.
ENCRYPTION_MASTER_KEY=gerado-pelo-script

# --- E-mail do escritório (Hostinger) ------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contato@efficio.com.br
SMTP_PASSWORD='senha-da-caixa-de-email'
MAIL_FROM=contato@efficio.com.br
LOG_LEVEL=info

# --- Backup (scripts/backup.sh) --------------------------------------------------------------------
BACKUP_DIR=/opt/efficio/backups
# Arquivo com a senha que cifra os backups (gerado pelo script, chmod 600).
BACKUP_PASSPHRASE_FILE=/opt/efficio/segredos/backup.senha
# Cópia para fora do servidor com rclone (vazio = desligado). Ex.: onedrive:Efficio-backups ou
# gdrive:Efficio-backups (nome do remoto criado com `rclone config`).
RCLONE_REMOTE=
# Dias que as cópias ficam no remoto.
RCLONE_KEEP_DAYS=60
# Monitor de backup (opcional, ex.: https://hc-ping.com/<id> do healthchecks.io): avisa por e-mail
# se um dia o backup não rodar.
BACKUP_PING_URL=
