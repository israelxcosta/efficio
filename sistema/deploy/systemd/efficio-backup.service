# Backup diário do Efficio (instalado por scripts/install.sh em /etc/systemd/system/).
# Ver o resultado: journalctl -u efficio-backup --since today
[Unit]
Description=Backup cifrado do banco do Efficio
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=efficio
Group=efficio
ExecStart=/opt/efficio/app/sistema/deploy/scripts/backup.sh
Nice=10
IOSchedulingClass=idle
# Endurecimento: sem novos privilégios, /usr e /etc somente leitura, /tmp privado.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectControlGroups=yes
