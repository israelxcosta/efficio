# Effinance API — environment variables (validated at startup by src/env.ts).
#
# LOCAL DEVELOPMENT TEMPLATE: `cp apps/api/.env.example apps/api/.env`. Every value here is either
# a public dev-only default or empty. Never commit `.env` (it is git- and docker-ignored) and never
# reuse these values outside your machine. In production every secret comes from AWS Secrets
# Manager through the ECS task definition `secrets` (docs/deploy-aws.md), not from a file.
#
# Generating strong secrets (any of them):
#   openssl rand -base64 48                       # JWT_SECRET, MAIL_WEBHOOK_SECRET
#   openssl rand -base64 32                       # ENCRYPTION_MASTER_KEY (exactly 32 bytes)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# PRODUCTION (NODE_ENV=production) — the API refuses to start unless:
#   MAILER is ses or webhook (webhook: https MAIL_WEBHOOK_URL + MAIL_WEBHOOK_SECRET);
#   DATABASE_SSL=verify-full; APP_URL and CORS_ORIGIN are https;
#   JWT_SECRET has 43+ characters and no placeholder text (dev-only, change-me, replace-me);
#   KEY_PROVIDER=aws (KMS_KEY_ID set). EFFINANCE_TODAY is ignored and the dev master key is never used.
#   OPEN_FINANCE_PROVIDER is pluggy or disabled (default disabled; fake refused); with pluggy:
#   PLUGGY_CLIENT_ID/SECRET, https API_PUBLIC_URL, OPEN_FINANCE_WEBHOOK_SECRET with 43+ URL-safe
#   characters and no placeholder text, PLUGGY_SANDBOX=false.

# --- Runtime -------------------------------------------------------------------------------------
# development | test | production. Production enables the strict checks in src/env.ts — always
# set it explicitly in deployed environments (the Docker image sets NODE_ENV=production).
NODE_ENV=development
PORT=3333
# Local dev: 127.0.0.1 keeps the API off the network. The container image uses 0.0.0.0.
HOST=127.0.0.1
# Proxy hops whose X-Forwarded-For is trusted: 0 = direct (local dev), 2 = CloudFront + ALB.
# Too high lets clients spoof their IP (rate limit / audit log bypass).
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database ------------------------------------------------------------------------------------
# Dev-only credentials from docker-compose.yml. In production: the API login role (effinance_api,
# member of effinance_app, no grants on financial tables) — never the master/owner user — with
# DATABASE_SSL=verify-full and the RDS CA bundle shipped in the image.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/effinance
# disable | require (TLS, no certificate check) | verify-full (production)
DATABASE_SSL=disable
# DATABASE_CA_FILE=/etc/ssl/certs/rds-ca-sa-east-1.pem

# --- Auth ----------------------------------------------------------------------------------------
# HMAC key of the access tokens. DEV-ONLY PLACEHOLDER below (public, so anyone could forge tokens
# with it): generate a fresh value for any deployed environment (openssl rand -base64 48).
JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0000000000
# Comma-separated list of allowed browser origins (CORS + CSRF origin check). https:// in production.
CORS_ORIGIN=http://localhost:5173
# Public URL of the web app (links in e-mails, checkout return URL). https:// in production.
APP_URL=http://localhost:5173

# --- Encryption at rest (envelope: one data key per workspace) -----------------------------------
#  local: master key in ENCRYPTION_MASTER_KEY (base64 of 32 random bytes). Empty in development =
#         built-in insecure dev key (refused when NODE_ENV=production).
#  aws:   AWS KMS customer managed key (required in production, see docs/deploy-aws.md §2).
KEY_PROVIDER=local
ENCRYPTION_MASTER_KEY=
# KMS_KEY_ID=arn:aws:kms:sa-east-1:<account-id>:key/<key-id>
# AWS_REGION=sa-east-1
# AWS credentials: never put access keys here. Locally use `aws sso login` / a named profile;
# in AWS the task role provides temporary credentials.

# --- E-mail --------------------------------------------------------------------------------------
# console (prints e-mails, including password-reset links, to the log — development only) |
# webhook (POST JSON to MAIL_WEBHOOK_URL) | ses (Amazon SES v2, production)
MAILER=console
MAIL_FROM=Effinance <nao-responda@effinance.app>
# MAIL_WEBHOOK_URL=https://<your-mail-relay>/send
# MAIL_WEBHOOK_SECRET=<openssl rand -base64 48>

# --- Billing -------------------------------------------------------------------------------------
# fake (dev/demo, POST /billing/dev/activate; refused in production) | mercadopago
BILLING_PROVIDER=fake
# Mercado Pago credentials (production: Secrets Manager `effinance/api/mercadopago`).
# MP_ACCESS_TOKEN=<APP_USR-... from "Suas integrações" — test credentials in development>
# MP_WEBHOOK_SECRET=<Suas integrações → Webhooks → Assinatura secreta>

# --- Open Finance (read-only bank connections) ------------------------------------------------
#  fake:     simulated institutions (Nubank, Itaú, BB, Inter…) — default in development/test, demo.
#  pluggy:   Pluggy aggregator (Open Finance Brasil). Production: Secrets Manager
#            `effinance/api/pluggy` (docs/deploy-aws.md §4 and §10b).
#  disabled: feature hidden (GET /api/open-finance/status → enabled:false). Default in production.
OPEN_FINANCE_PROVIDER=fake
# PLUGGY_CLIENT_ID=<dashboard.pluggy.ai → Applications>
# PLUGGY_CLIENT_SECRET=<idem; never in the browser>
# Accept Pluggy's sandbox connectors (non-Open-Finance test banks). Development only.
# PLUGGY_SANDBOX=false
# Secret LAST PATH SEGMENT of the webhook URL (the logs mask it). URL-safe, 32+ chars (43+ in
# production): openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
# OPEN_FINANCE_WEBHOOK_SECRET=
# Public base URL of this API as the aggregator reaches it (CloudFront: the app domain, since /api/*
# is routed to the API). Webhooks: ${API_PUBLIC_URL}/api/open-finance/webhooks/pluggy/<secret>.
# Only https URLs receive webhooks (local http setups just sync on demand).
# API_PUBLIC_URL=https://app.effinance.com.br

# --- Rate limit store (optional; required with 2+ API instances) ---------------------------------
# Production: ElastiCache with TLS + AUTH, e.g. rediss://<user>:<password>@<endpoint>:6379
# REDIS_URL=redis://localhost:6379

# --- Tests only (read by apps/api/test and vitest.config.ts, never by the server) ----------------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/effinance_test
# EFFINANCE_TODAY pins the calendar date in tests. NEVER set it in a deployed environment.
